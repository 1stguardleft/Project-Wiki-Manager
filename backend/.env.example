# Copy to backend/.env and fill in. backend/.env is gitignored.
#
# Option A — Azure OpenAI gateway (e.g. SKAX AI TalentLab)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://skax.ai-talentlab.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Option B — standard OpenAI (used only if the Azure vars are empty)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Models (Azure: these are deployment names)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Default policy for resolving a contradiction against an existing page.
# An ingest request may override this per source.
#   manual          — keep both pages, leave the merge record pending for review
#   prefer_incoming — newer doc wins (older marked superseded)
#   prefer_existing — existing wins (incoming parked as a rejected page)
CONFLICT_POLICY=manual
